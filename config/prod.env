# PROD — dati reali. Solo valori NON sensibili: sono gli stessi di
# k8s/prod/configmap-patch.yaml (se cambiate uno, cambiate l'altro nello stesso commit).
# Le credenziali (DATABASE_URL, JWT_SEGRETO, CHIAVE_INTERNA, password dei database) NON
# stanno qui né in nessun file del repository: le crea con kubectl chi gestisce il
# cluster di produzione (docs/deployment.md, "PROD"), e non girano sui portatili.

LISTEN_ADDR=0.0.0.0:8080
# il dominio vero del cliente (da decidere: ora è un segnaposto .example)
CORS_ORIGIN=https://lastmile.veloce24.example
# in produzione si entra solo con il login
IDENTITA_HEADER_SVILUPPO=disattiva
DURATA_TOKEN=15m
DURATA_SESSIONE=12h
# pagina del frontend a cui punta il link della mail di recupero password (+ ?token=...)
LINK_RECUPERO_PASSWORD=https://lastmile.veloce24.example/
URL_SERVIZIO_UTENTI=http://utenti-svc:8080
URL_SERVIZIO_SPEDIZIONI=http://spedizioni-svc:8080

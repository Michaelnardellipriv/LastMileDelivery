# DEV — sul portatile, dati finti (db/globale/seed.sql e db/spedizioni/seed.sql).
# Copiatelo in config/dev.env (ignorato da git) e scegliete le due password: valgono solo
# per i database usa-e-getta del docker compose. config/dev.env non va mai committato.
#   Copy-Item config/dev.env.example config/dev.env      # PowerShell
#   cp config/dev.env.example config/dev.env             # bash
# Se cambiate le password dopo il primo avvio, i database già creati tengono le vecchie:
# docker compose down -v li ricrea (con i dati di prova).

POSTGRES_USER=lastmile
POSTGRES_PASSWORD=
POSTGRES_DB=lastmile
# i due database (stesse credenziali): globale sulla 5432, spedizioni sulla 5433
DB_PORT=5432
DB_SPEDIZIONI_PORT=5433
# utente NORMALE con cui si collega il backend: lo crea db/ruolo_applicazione.sh al primo
# avvio del database. POSTGRES_USER è superutente e ignorerebbe la Row-Level Security.
APP_DB_USER=lastmile_app
APP_DB_PASSWORD=

# backend avviato sul PC con "go run ./cmd/server" (i due microservizi nello stesso
# processo): i database sono su localhost. Mettete al posto di <APP_DB_PASSWORD> la password
# scelta sopra. Nel docker compose questi valori vengono sostituiti con gli host
# "db-globale" e "db-spedizioni" (vedi docker-compose.yml).
DATABASE_URL=postgres://lastmile_app:<APP_DB_PASSWORD>@localhost:5432/lastmile?sslmode=disable
DATABASE_SPEDIZIONI_URL=postgres://lastmile_app:<APP_DB_PASSWORD>@localhost:5433/lastmile?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
# app Flutter web avviata con: flutter run -d chrome --web-port 5173
CORS_ORIGIN=http://localhost:5173

# TEST — su MicroK8s, dati di prova. Diventa la ConfigMap "backend-config":
#   microk8s kubectl create configmap backend-config --from-env-file=config/test.env \
#     --dry-run=client -o yaml | microk8s kubectl apply -f -
# NESSUN secret qui: DATABASE_URL e le credenziali del database arrivano dal
# Secret "db-secret" (k8s/secret.yaml è solo l'esempio con valori finti).

# dentro il container deve ascoltare su tutte le interfacce, non su 127.0.0.1
LISTEN_ADDR=0.0.0.0:8080
# frontend e API sotto lo stesso host dell'Ingress (k8s/ingress.yaml)
CORS_ORIGIN=http://lastmile.test
MAX_TENTATIVI=3
GIORNI_VISIBILITA_CLIENTE=30

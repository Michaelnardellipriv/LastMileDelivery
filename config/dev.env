# DEV — sul portatile, dati finti (db/seed.sql).
# Versionato di proposito: la password qui sotto vale SOLO per il database
# locale usa-e-getta del docker compose, non protegge nessun dato reale.
# Le credenziali di TEST e PROD non stanno mai in un file del repository.

POSTGRES_USER=lastmile
POSTGRES_PASSWORD=dev-solo-locale
POSTGRES_DB=lastmile
DB_PORT=5432

# backend avviato sul PC con "go run": il database è su localhost.
# Nel docker compose questo valore viene sostituito con host "db" (vedi docker-compose.yml).
DATABASE_URL=postgres://lastmile:dev-solo-locale@localhost:5432/lastmile?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
# app Flutter web avviata con: flutter run -d chrome --web-port 5173
CORS_ORIGIN=http://localhost:5173
MAX_TENTATIVI=3
GIORNI_VISIBILITA_CLIENTE=30

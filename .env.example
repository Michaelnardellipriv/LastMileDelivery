# .env.example — questo file VA nel repository: elenca tutte le variabili
# che servono per avviare l'applicazione, SENZA valori veri.
# Copiatelo in .env (escluso da git con .gitignore) e compilatelo.
# Spiegazione completa, default e valori per ambiente: docs/configuration.md

# ── Database (letti dall'immagine postgres all'avvio del container db) ──
POSTGRES_USER=utente
POSTGRES_PASSWORD=
POSTGRES_DB=lastmile
# porte del PC su cui pubblicare i due database (solo docker compose)
DB_PORT=5432
DB_SPEDIZIONI_PORT=5433
# utente normale del backend, creato al primo avvio del database (db/ruolo_applicazione.sh):
# è quello da mettere in DATABASE_URL, perché POSTGRES_USER ignora la Row-Level Security
APP_DB_USER=lastmile_app
APP_DB_PASSWORD=

# ── Backend Go (letti all'avvio da backend/internal/avvio) ──
# Due microservizi: cmd/utenti (database globale) e cmd/spedizioni (database delle
# spedizioni). cmd/server, per lo sviluppo, li fa girare insieme e usa tutti e due gli URL.
# obbligatoria: il database del servizio (per cmd/server: il database globale)
DATABASE_URL=postgres://lastmile_app:password@host:5432/lastmile?sslmode=disable
# solo cmd/server: il database delle spedizioni (gruppo di sedi 0, il principale)
DATABASE_SPEDIZIONI_URL=postgres://lastmile_app:password@host:5433/lastmile?sslmode=disable
# facoltative, solo cmd/server: i database delle spedizioni degli altri gruppi di sedi
# (DATABASE_SPEDIZIONI_URL_1, _2, ...; mappa sede → database, docs/microservizi.md).
# Il database deve essere stato creato con GRUPPO_SPEDIZIONI=1, altrimenti il backend non parte.
# In cmd/spedizioni le stesse si chiamano DATABASE_URL_1, _2, ...
#DATABASE_SPEDIZIONI_URL_1=postgres://lastmile_app:password@host:5434/lastmile?sslmode=disable
# solo per il container del database delle spedizioni di un gruppo diverso da 0, alla prima
# creazione (vuota o 0 = gruppo 0; nel database globale resta vuota)
#GRUPPO_SPEDIZIONI=1
# porta del PC del database del gruppo 1 (solo docker compose, profilo "gruppo1")
#DB_SPEDIZIONI_1_PORT=5434
# solo cmd/utenti e cmd/spedizioni: dove trovare l'altro servizio
URL_SERVIZIO_UTENTI=http://utenti-svc:8080
URL_SERVIZIO_SPEDIZIONI=http://spedizioni-svc:8080
# obbligatoria per cmd/utenti e cmd/spedizioni (la stessa per i due), almeno 32
# caratteri: protegge le chiamate /interno tra i servizi
CHIAVE_INTERNA=
# obbligatoria: origine del frontend che il browser può usare (schema://host:porta,
# senza barra finale). Più origini separate da virgola.
CORS_ORIGIN=http://localhost:5173
# facoltative, con default
LISTEN_ADDR=127.0.0.1:8080
# pagina del FRONTEND a cui punta il link della mail di recupero password: il backend aggiunge
# da solo "?token=<token>" (non scriverlo qui). Predefinito: http://localhost:5173/
LINK_RECUPERO_PASSWORD=http://localhost:5173/

# .env.example — questo file VA nel repository: elenca tutte le variabili
# che servono per avviare l'applicazione, SENZA valori veri.
# Copiatelo in .env (escluso da git con .gitignore) e compilatelo.
# Spiegazione completa, default e valori per ambiente: docs/configuration.md

# ── Database (letti dall'immagine postgres all'avvio del container db) ──
POSTGRES_USER=utente
POSTGRES_PASSWORD=
POSTGRES_DB=lastmile
# porta del PC su cui pubblicare il database (solo docker compose)
DB_PORT=5432

# ── Backend Go (letti da backend/cmd/server/main.go all'avvio) ──
# obbligatoria: senza, il backend si ferma subito
DATABASE_URL=postgres://utente:password@host:5432/lastmile?sslmode=disable
# obbligatoria: origine del frontend che il browser può usare (schema://host:porta,
# senza barra finale). Più origini separate da virgola.
CORS_ORIGIN=http://localhost:5173
# facoltative, con default
LISTEN_ADDR=127.0.0.1:8080
MAX_TENTATIVI=3
GIORNI_VISIBILITA_CLIENTE=30
